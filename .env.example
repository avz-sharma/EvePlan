# Gemini API Key (Optional for demo pill testing; graceful degraded mode when unset)
GEMINI_API_KEY=

# Model selection; at most one intent-extraction call per replan, then deterministic fallback
GEMINI_MODEL=gemini-2.5-flash-lite


# Allowed Origins (CORS)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Per-instance abuse limits. Upload validation also has a fixed 5 MiB cap.
MAX_REQUEST_BYTES=6291456
API_REQUESTS_PER_MINUTE=240

# Frontend API origin (leave blank to use the same origin and the Vite /api proxy locally)
VITE_API_BASE_URL=
