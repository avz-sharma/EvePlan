{
  "name": "celebration-planner-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit && eslint src --max-warnings 0",
    "test": "vitest run",
    "sync-types": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "check:unused": "knip --no-progress",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "playwright test",
    "measure:bundle": "node scripts/measure-build.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.20",
    "axe-core": "4.14.0",
    "chrome-devtools-mcp": "^1.12.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "knip": "^6.44.0",
    "lighthouse": "^13.6.0",
    "openapi-typescript": "^7.3.0",
    "postcss": "^8.4.41",
    "rollup-plugin-visualizer": "5.14.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.12",
    "vitest-axe": "^0.1.0"
  }
}
