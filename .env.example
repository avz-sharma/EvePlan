# Gemini API Key (Optional for demo pill testing; graceful degraded mode when unset)
GEMINI_API_KEY=

# Free-tier-safe default and optional fallback
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Server-only key. Restrict this key to Places API (New); never put it in VITE_* variables.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_RPM_LIMIT=5
GOOGLE_PLACES_DAILY_LIMIT=100

# Allowed Origins (CORS)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Max Upload Size in Bytes (5 MB default)
MAX_UPLOAD_BYTES=5242880

# Frontend API origin (leave blank to use the same origin and the Vite /api proxy locally)
VITE_API_BASE_URL=

# Public browser key. Restrict by HTTP referrer and Maps JavaScript API only.
VITE_GOOGLE_MAPS_BROWSER_KEY=

