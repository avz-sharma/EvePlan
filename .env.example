# GroqCloud API key (server-side only; create one in the Groq Console)
GROQ_API_KEY=

# Groq model used for natural-language changes and saved quote analysis
GROQ_MODEL=qwen/qwen3.8-27b


# Allowed Origins (CORS)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Per-instance abuse limits. Upload validation also has a fixed 5 MiB cap.
MAX_REQUEST_BYTES=6291456
API_REQUESTS_PER_MINUTE=240

# Frontend API origin (leave blank to use the same origin and the Vite /api proxy locally)
VITE_API_BASE_URL=

# Google OAuth web client (not a Maps key). Server secrets must never use VITE_*.
# Add http://localhost:5173 as an authorized JavaScript origin and
# http://localhost:5173/api/auth/callback as an authorized redirect URI.
AUTH_REQUIRED=true
APP_ORIGIN=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Generate a random secret of at least 32 characters; keep stable across deployments.
SESSION_SECRET=
